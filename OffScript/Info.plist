<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.offscript.feed-refresh</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>SentryDSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.offscript.app.playing</string>
		<string>com.offscript.app.viewing-podcast</string>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.opml.opml</string>
			<key>UTTypeDescription</key>
			<string>OPML Subscription Export</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>opml</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>text/x-opml</string>
					<string>text/xml</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>OPML Subscription Export</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.opml.opml</string>
				<string>public.xml</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.offscript.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>offscript</string>
			</array>
		</dict>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>PlayfairDisplay-Variable.ttf</string>
		<string>PlayfairDisplay-Italic-Variable.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<!--
	  CarPlay scene config removed until com.apple.developer.carplay-audio
	  is granted for this team. To re-enable, restore inside UISceneConfigurations:
	    <key>CPTemplateApplicationSceneSessionRoleApplication</key>
	    <array>
	      <dict>
	        <key>UISceneClassName</key>
	        <string>CPTemplateApplicationScene</string>
	        <key>UISceneConfigurationName</key>
	        <string>CarPlay</string>
	        <key>UISceneDelegateClassName</key>
	        <string>OffScript.OffScriptCarPlaySceneDelegate</string>
	      </dict>
	    </array>
	  …and add the carplay-audio entitlement back in OffScript.entitlements.
	-->
</dict>
</plist>
